// --- System Initialization ---
document.addEventListener("DOMContentLoaded", () => {
  initSmoothScroll();
  initLoader();
  initHUD();
  initCursor();
  initSpotlight();
  initGSAPAnimations();
});

function initSmoothScroll() {
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: true,
  });

  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);
}

function initLoader() {
  const progress = document.querySelector(".progress");
  const loader = document.getElementById("loader");

  let width = 0;
  const interval = setInterval(() => {
    width += Math.random() * 15;
    if (width >= 100) {
      width = 100;
      clearInterval(interval);
      setTimeout(() => {
        loader.style.opacity = "0";
        setTimeout(() => loader.style.display = "none", 800);
      }, 500);
    }
    progress.style.width = width + "%";
  }, 100);
}

function initHUD() {
  const body = document.body;
  for (let i = 0; i < 10; i++) {
    const vLine = document.createElement("div");
    vLine.className = "hud-line hud-vertical";
    vLine.style.left = Math.random() * 100 + "vw";
    body.appendChild(vLine);

    const hLine = document.createElement("div");
    hLine.className = "hud-line hud-horizontal";
    hLine.style.top = Math.random() * 100 + "vh";
    body.appendChild(hLine);
  }
}

function initCursor() {
  const cursor = document.getElementById("custom-cursor");
  const dot = cursor.querySelector(".cursor-dot");
  const outline = cursor.querySelector(".cursor-outline");
  const text = cursor.querySelector(".cursor-text");

  window.addEventListener("mousemove", (e) => {
    gsap.to(cursor, {
      x: e.clientX,
      y: e.clientY,
      duration: 0,
    });
    gsap.to(outline, {
      x: e.clientX,
      y: e.clientY,
      duration: 0.15,
    });
  });

  document.querySelectorAll("a, .btn, .project-card, .exp-item").forEach(el => {
    el.addEventListener("mouseenter", () => {
      gsap.to(outline, { scale: 2, backgroundColor: "rgba(0, 242, 255, 0.1)", duration: 0.3 });
      gsap.to(dot, { scale: 0.5, duration: 0.3 });
      text.style.opacity = "1";
      text.textContent = "VIEW";
    });
    el.addEventListener("mouseleave", () => {
      gsap.to(outline, { scale: 1, backgroundColor: "transparent", duration: 0.3 });
      gsap.to(dot, { scale: 1, duration: 0.3 });
      text.style.opacity = "0";
    });
  });
}

function initSpotlight() {
  const spotlight = document.createElement("div");
  spotlight.className = "spotlight";
  document.body.appendChild(spotlight);

  window.addEventListener("mousemove", (e) => {
    spotlight.style.setProperty("--x", e.clientX + "px");
    spotlight.style.setProperty("--y", e.clientY + "px");
  });
}

function initGSAPAnimations() {
  gsap.registerPlugin(ScrollTrigger);

  // 1. High-End Hero Entry
  gsap.set(".hero h1", { opacity: 0, y: 100, rotateX: -45 });
  gsap.set(".hero p, .cta-group", { opacity: 0, y: 30 });

  const tlHero = gsap.timeline({
    delay: 1.5,
    onStart: () => {
      // Optional: trigger a sound effect or specialized loader end here
    }
  });

  tlHero.to(".hero h1", {
    opacity: 1,
    y: 0,
    rotateX: 0,
    duration: 1.8,
    ease: "expo.out"
  })
  .to(".hero p", {
    opacity: 1,
    y: 0,
    duration: 1.2,
    ease: "power4.out"
  }, "-=1")
  .to(".cta-group", {
    opacity: 1,
    y: 0,
    duration: 1.2,
    ease: "power4.out"
  }, "-=0.8");

  // 2. Bento "Explosion" Reveal
  gsap.from(".profile-card", {
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
      end: "bottom 20%",
      scrub: 1,
    },
    x: (i) => (i % 2 === 0 ? -100 : 100),
    y: 100,
    opacity: 0,
    rotate: (i) => (i % 2 === 0 ? -10 : 10),
    scale: 0.8,
    duration: 1,
    ease: "power2.out"
  });

  // 3. Experience "Magnetic" Items
  gsap.from(".exp-item", {
    scrollTrigger: {
      trigger: "#experience",
      start: "top 80%",
    },
    opacity: 0,
    x: -50,
    stagger: 0.15,
    duration: 1,
    ease: "expo.out"
  });

  // 4. Project "Stacking" Effect
  // We simulate a stacking effect by creating a sticky-like feel with GSAP
  const projects = document.querySelectorAll(".project-card");
  projects.forEach((card, i) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: "top 90%",
        end: "top 20%",
        scrub: true,
      },
      scale: 0.8 + (i * 0.02), // Subtle scale difference
      opacity: 0,
      y: 100,
      ease: "power1.inOut"
    });
  });
}
